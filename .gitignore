# Build output
/out/
/build/
# Separate local checkout of the publishing repository
/FF3 Recomp/
CMakeUserPresets.json

# Build directories created outside /out/ (per-stage trees use names like b457_perf)
b*_perf/
cmake-build-*/

# Binary build artifacts, wherever they land
*.exe
*.dll
*.lib
*.obj
*.exp
*.iobj
*.ipdb
*.res
*.tlog

# Copyrighted game data.  Never publish: the PSP executable, its decrypted ELF
# and save data are the user's own dumped media, not part of this source tree.
PSP_DATA/
SAVEDATA/
*.ELF
*.elf
*.iso
*.cso

# User-owned game data and reverse-engineering workspace
/profiles/*/game/
/profiles/*/analysis/
/profiles/*/progress/
/profiles/*/captures/

# Locally translated commercial executable code
/profiles/*/generated/

# Local download bundles (keep the whole bundle private, including sidecars)
/Final_Fantasy_III_*/
*.pbp
*.PBP
*.prx
*.PRX
*.ISO
*.CSO
*.zip
*.7z
*.rar

# Host caches, credentials, and compiler outputs
.DS_Store
._*
.env
.env.*
!.env.example
*.pem
*.key
*.o
*.a
*.so
*.dylib
*.dSYM/
*.app/
compile_commands.json
.venv/

# Generated scratch output
*.generated
*.tmp
*.log
*.pdb
*.ilk

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo

# Python
__pycache__/
*.pyc
